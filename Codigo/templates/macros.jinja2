{% macro Tablero(Tamaño, Fila, Columna) %}
<div class="matriz">
  {% for i in range(Tamaño) %}
    <div class="fila">
      {% for j in range(Tamaño) %}
        <div class="celda{% if i == Fila and j == Columna %} caballo{% endif %}"></div>
      {% endfor %}
    </div>
  {% endfor %}
</div>
{% endmacro %}


{% macro MostrarMatriz(M) %}
<div class="matriz">
  {% for i, fila in enumerate(M) %}
    <div class="fila">
      {% for j, val in enumerate(fila) %}
        {% set visitada = (val == 0) %}
        {% set esCaballo = (val == 1) %}
        <div class="celda
        {% if visitada %} 
        visitada
        {% endif %}
        {% if esCaballo %} 
            caballo 
            {% if visitada %}
                negro
            {% else %}
                blanco
            {% endif %}
        {% endif %}">
        </div>
      {% endfor %}
    </div>
  {% endfor %}
</div>
{% endmacro %}
