{# Macro para  el tablero de ajedrez con el caballo #}
{% macro Tablero(Tamaño, Fila, Columna) %}
<div class="matriz">
    {% for i in range(Tamaño) %}
        <div class="fila">
            {% for j in range(Tamaño) %}
                {% if i == Fila and j == Columna %}
                    <div class="caballo"></div>
                {% else %}
                    <div class="celda"></div>
                {% endif %}
            {% endfor %}
        </div>
    {% endfor %}
</div>
{% endmacro %}

{% macro MostrarMatriz(Matriz) %}
    {% for fila in Matriz %}
        {% for elemento in fila %}
            {% if elemento == 0 %}
                <div class="Recorrido">
            {% endif %}
            {% if elemento == -1 %}
                <div class="celda"></div>
            {% endif %}
            {% if elemento == 1 %}
                <div class="caballo"></div>
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endmacro %}
